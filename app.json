{
  "expo": {
    "name": "GymTrackr",
    "slug": "gymtrackr",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f7f5f0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
