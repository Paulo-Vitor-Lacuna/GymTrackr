{
  "name": "gymtrackr",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start --go --host lan --port 8081",
    "mobile:tunnel": "node scripts/require-expo-token.js && expo whoami && node scripts/start-expo-tunnel.js",
    "mobile:qr": "node scripts/print-expo-qr.js",
    "web": "expo start --web --host lan --port 8081",
    "test": "tsx --test __tests__/workout.test.ts",
    "test:watch": "tsx --watch --test __tests__/workout.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.7",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
